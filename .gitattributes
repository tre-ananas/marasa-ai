# Normalise text files to LF in the repository; check out with the platform's
# convention only where the platform requires it.
* text=auto eol=lf

# Windows scripts must be CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary-ish assets.
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
