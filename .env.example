# Marasa AI — local environment
# Copy to .env only if you need to override the defaults below.
# .env is gitignored.
#
# Marasa runs only on this device. Each browser session signs in with an
# OpenCode Go API key. The key is held in memory only: it is never written to
# data/settings.json and is discarded when the browser session ends or the
# server restarts.

# --- OpenCode Go ----------------------------------------------------------
# Marasa always calls https://opencode.ai/inference/go, so requests draw from
# the signed-in user's Go subscription allowance.
MARASA_PROVIDER=console
MARASA_OPENCODE_ENDPOINT=go

# Optional developer fallback. Leave empty in normal use; the sign-in flow
# supplies the key per browser session instead.
MARASA_OPENCODE_API_KEY=

# Default model. Leave empty to use MiniMax M3.
MARASA_MODEL=

# --- PDF rendering --------------------------------------------------------
# chromium = Playwright's bundled Chromium (run: playwright install chromium)
# edge     = use the Microsoft Edge already installed on Windows (no download)
MARASA_PDF_ENGINE=edge

# --- Server ---------------------------------------------------------------
# 8787 keeps Marasa out of the way of other apps on port 8000.
# The server binds only to loopback.
MARASA_HOST=127.0.0.1
MARASA_PORT=8787
