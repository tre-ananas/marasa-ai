# Marasa AI — local environment
# Copy to .env and fill in what you need. .env is gitignored.

# --- Provider -------------------------------------------------------------
# mock    : offline scripted replies (default, no key, used by tests)
# console : OpenCode Console / OpenCode Go inference API (uses your own budget)
# local   : your locally running OpenCode server (opencode serve)
# ollama  : a local Ollama model (e.g. qwen3:8b)
MARASA_PROVIDER=mock

# OpenCode Console / Go API key (https://opencode.ai/console -> API keys).
# Needed for: console provider, and for the free-tier models that OpenCode
# only exposes to signed-in OpenCode clients.
MARASA_OPENCODE_API_KEY=

# Model id. Leave empty to use the provider's default model.
# For Ollama the default comes from MARASA_OLLAMA_MODEL below.
MARASA_MODEL=

# --- Local model (optional) ----------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
MARASA_OLLAMA_MODEL=qwen3:8b
# Context window. Ollama defaults to 4K, which is too small for the tutor
# system prompt plus a conversation; 8K is a good balance on a 6 GB GPU.
MARASA_OLLAMA_NUM_CTX=8192

# --- PDF rendering --------------------------------------------------------
# chromium = Playwright's bundled Chromium (run: playwright install chromium)
# edge     = use the Microsoft Edge already installed on Windows (no download)
MARASA_PDF_ENGINE=edge

# --- Server ---------------------------------------------------------------
MARASA_HOST=127.0.0.1
MARASA_PORT=8000
